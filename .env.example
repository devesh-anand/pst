# Copy to .env and adjust. All variables are optional unless noted.

# Listen address.
PST_ADDR=:8080

# SQLite database file (metadata and content).
PST_DB_PATH=data/pst.db

# Storage backends. Only "sqlite" exists today; see README for adding others.
PST_META_STORE=sqlite
PST_BLOB_STORE=sqlite

# Random ID length (base62). 10 chars = ~59 bits.
PST_ID_LENGTH=10

# Max size of an encrypted paste envelope, in bytes (default 2 MiB).
PST_MAX_PASTE_BYTES=2097152

# Allow pastes that never expire.
PST_ALLOW_NEVER_EXPIRE=true

# Feature flag: require a password to create pastes. Reads stay public to
# anyone with the link. PST_WRITE_PASSWORD must be at least 12 characters.
PST_REQUIRE_WRITE_PASSWORD=true
PST_WRITE_PASSWORD=change-me-to-a-long-random-string

# Header your reverse proxy sets with the real client IP, used for rate
# limiting. Leave empty if pst is not behind a proxy (the header is spoofable).
# Caddy/nginx: X-Real-IP   Cloudflare: CF-Connecting-IP
PST_CLIENT_IP_HEADER=
